# S3 server: s3.amazonaws.com (default), <account-id>.r2.cloudflarestorage.com, ...
S3_ENDPOINT=
# Leave empty to use the AWS credentials chain (AWS_* variables, ~/.aws, IAM role)
S3_ID=
S3_KEY=
S3_BUCKET=
# Optional
#S3_REGION=eu-west-3
#S3_SESSION_TOKEN=
#S3_URL_STYLE=auto
#S3_PREFIX=mongodb/
#S3_SECURE=true
# Backups older than this number of days are deleted (0 or empty = keep forever)
S3_RETENTION=30
# The most recent backups are never deleted, whatever their age
#S3_KEEP_MIN=3
# Upload part size in MiB (one part is kept in memory)
#S3_PART_SIZE=64
# Validity of the download links sent to Discord (max 168h)
#PRESIGN_EXPIRY=168h

# MongoDB connection string
MONGO_URI=mongodb://user:password@localhost:27017
#MONGODUMP_PATH=mongodump
#MONGODUMP_GZIP=true
# Point-in-time consistent backup, replica sets only
#MONGODUMP_OPLOG=true

# Encrypt the archive with age public keys (age-keygen) or SSH public keys
#AGE_RECIPIENTS=age1...
#AGE_RECIPIENTS_FILE=/etc/mongobackup/recipients.txt

# Warn (and skip retention) when the archive is that much smaller than the previous one
#SIZE_ALERT_PERCENT=30

# Name of this server in notifications (hostname by default)
#BACKUP_NAME=
# Discord webhook (optional, notifications are disabled when empty)
DISCORD_URL=
